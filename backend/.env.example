# Server
PORT=3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
# Docker 容器 mysql-react-ai 默认密码为 123456
DB_NAME=react_ai

# JWT
JWT_SECRET=please_change_me_to_a_random_secret
JWT_EXPIRES_IN=7d

# LLM Provider（OpenAI 兼容接口，按实际服务商填写 baseUrl 与 model）
# OpenAI:  https://api.openai.com/v1          + gpt-4o-mini
# DeepSeek: https://api.deepseek.com/v1       + deepseek-chat
# 通义:    https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-turbo
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# 上下文压缩（可选，有默认值）
# CONTEXT_RECENT_MESSAGES=20          # 保留最近 N 条完整消息
# CONTEXT_COMPRESS_TOKEN_THRESHOLD=6000  # 超过此估算 token 时触发压缩
# CONTEXT_MAX_TOKENS=8000           # 发给聊天模型的上下文 token 上限

# 文件上传
# UPLOAD_DIR=uploads
# UPLOAD_MAX_SIZE_MB=5              # 整包上传上限（小文件快速通道）
# UPLOAD_MAX_TEXT_CHARS=80000
# UPLOAD_MAX_FILES_PER_MESSAGE=3
# CHUNK_SIZE_MB=2                   # 分片大小
# CHUNK_UPLOAD_MAX_SIZE_MB=50       # 分片上传总文件上限
# UPLOAD_SESSION_TTL_HOURS=24       # 未完成上传会话保留时间

# MCP / Tavily 联网搜索
# 申请：https://app.tavily.com（免费 1000 次/月）
# 留空时 tavily MCP Server 会启动失败但不影响其它功能，可在 mcp.config.json 中关闭
TAVILY_API_KEY=
